{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts", "src/server/**/*.ts", "e2e/**/*.ts", "vitest.config.ts", "playwright.config.ts"]
}
