{
  "name": "mitra",
  "productName": "Mitra",
  "version": "0.2.2",
  "description": "Mitra \u2014 cross-platform desktop voice AI assistant (Bolna Buildathon)",
  "author": "Mitra Team",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "dist": "electron-vite build && electron-builder --win nsis portable",
    "e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.0.0",
    "vosk-browser": "^0.0.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@bolna/web-call": "^3.0.1",
    "@pixiv/three-vrm": "^3.0.0",
    "@playwright/test": "^1.50.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.182.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wawa-lipsync": "latest"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true
  }
}
